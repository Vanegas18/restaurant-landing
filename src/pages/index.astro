---
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Footer from '../components/Footer.astro'
import Delivery from '../components/Delivery.astro'
import OrderApp, { type Photo } from '../components/order/OrderApp'
import type { PhotoKey } from '../lib/menu'
import la70 from '../assets/menu/la-70-doble.jpg'
import clasica from '../assets/menu/clasica.jpg'
import pollo from '../assets/menu/pollo-crocante.jpg'
import papas from '../assets/menu/papas.jpg'
import perro from '../assets/menu/perro.jpg'

// Fotos optimizadas en build (WebP, 3 anchos) y pasadas a la isla de React
const sources: Record<PhotoKey, [ImageMetadata, string]> = {
  'la-70-doble': [la70, 'Hamburguesa doble con cheddar fundido'],
  clasica: [clasica, 'Hamburguesa clásica con lechuga, tomate y cebolla morada'],
  'pollo-crocante': [pollo, 'Sándwich de pollo apanado con pepinillos'],
  papas: [papas, 'Papas fritas rústicas servidas en papel'],
  perro: [perro, 'Perro caliente con tomate, jalapeño y mostaza'],
}

const photos = {} as Record<PhotoKey, Photo>
for (const [key, [img, alt]] of Object.entries(sources) as [PhotoKey, [ImageMetadata, string]][]) {
  const widths = [240, 400, 640, 900]
  const variants = await Promise.all(widths.map((w) => getImage({ src: img, width: w, height: Math.round(w * 0.75), fit: 'cover', format: 'webp' })))
  photos[key] = {
    src: variants[2].src,
    srcSet: variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', '),
    width: 640,
    height: 480,
    alt,
  }
}
---

<Layout>
  <Header />
  <main>
    <Hero />
    <OrderApp client:load photos={photos} />
    <Delivery />
  </main>
  <Footer />
</Layout>
