---
import WhatsAppIcon from '@/components/WhatsAppIcon.astro'
import { buildWhatsAppUrl, DEFAULT_MESSAGE } from '@/lib/whatsapp'

const waUrl = buildWhatsAppUrl(DEFAULT_MESSAGE)
---

<section class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="relative overflow-hidden rounded-3xl border border-border bg-card px-6 py-14 text-center sm:px-10">

      <div aria-hidden="true" class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-primary/20 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -right-16 h-64 w-64 rounded-full bg-accent/20 blur-3xl"></div>

      <div class="relative flex flex-col items-center gap-6">
        <h2 class="text-balance text-3xl font-black tracking-tight sm:text-5xl">
          ¿Listo para ordenar?
        </h2>
        <p class="max-w-lg text-pretty text-lg text-muted-foreground">
          Tu próxima comida está a un mensaje de distancia. Escríbenos y la
          preparamos al instante.
        </p>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-14 items-center justify-center gap-2 rounded-md bg-[#25D366] px-8 text-base font-semibold text-black transition-colors hover:bg-[#1fbb57]"
        >
          <WhatsAppIcon class="h-6 w-6" />
          Escribir por WhatsApp
        </a>
      </div>

    </div>
  </div>
</section>