---
const benefits = [
  {
    title: "Entrega rápida",
    description: "Tu pedido llega calientito en aproximadamente 30 minutos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />`,
  },
  {
    title: "Ingredientes frescos",
    description: "Compramos a diario para servirte siempre lo mejor.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />`,
  },
  {
    title: "Pedido fácil",
    description: "Sin apps ni registros. Todo se resuelve por WhatsApp.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3m-3 3h3m-3 3h3" />`,
  },
  {
    title: "Trato amable",
    description: "Atención cercana y personalizada en cada pedido.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />`,
  },
]
---

<section id="beneficios" class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {benefits.map((b) => (
        <div class="flex flex-col items-start gap-4 rounded-2xl border border-border bg-card p-6">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/15 text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-6 w-6"
              set:html={b.icon}
            />
          </span>
          <div class="space-y-1.5">
            <h3 class="text-lg font-bold">{b.title}</h3>
            <p class="text-pretty text-sm leading-relaxed text-muted-foreground">
              {b.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>