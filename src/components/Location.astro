---
const hours = [
  { day: "Lunes a Jueves", time: "11:00a.m. – 09:00p.m." },
  { day: "Viernes y Sábado", time: "12:00p.m. – 01:00a.m." },
  { day: "Domingo", time: "01:00p.m. – 08:00p.m." },
]

const mapPin = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />`
const phone = `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 6.75z" />`
const clock = `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />`
---

<section id="ubicacion" class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid items-stretch gap-8 lg:grid-cols-2">

      <!-- Info -->
      <div class="flex flex-col justify-center gap-6">
        <div class="space-y-3">
          <span class="text-sm font-semibold uppercase tracking-wider text-primary">
            Visítanos
          </span>
          <h2 class="text-balance text-3xl font-black tracking-tight sm:text-4xl">
            Estamos cerca de ti
          </h2>
        </div>

        <ul class="space-y-5">
          <li class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" set:html={mapPin} />
            </span>
            <div>
              <p class="font-semibold">Dirección</p>
              <p class="text-sm text-muted-foreground">Av. Oriental, Col. Centro, Medellín</p>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/15 text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" set:html={phone} />
            </span>
            <div>
              <p class="font-semibold">Teléfono / WhatsApp</p>
              <p class="text-sm text-muted-foreground">+57 3006764605</p>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" set:html={clock} />
            </span>
            <div class="flex-1">
              <p class="font-semibold">Horario</p>
              <ul class="mt-1 space-y-1">
                {hours.map((h) => (
                  <li class="flex justify-between gap-4 text-sm text-muted-foreground">
                    <span>{h.day}</span>
                    <span class="font-medium text-foreground">{h.time}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        </ul>
      </div>

      <!-- Mapa decorativo -->
      <div class="relative min-h-64 overflow-hidden rounded-2xl border border-border">
  <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.131009555525!2d-75.56882902501778!3d6.246461226320772!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e4428564b11568f%3A0x82d2230174da3fbe!2sCentro%20Comercial%20El%20Punto%20de%20La%20Oriental!5e0!3m2!1ses-419!2sco!4v1780895398767!5m2!1ses-419!2sco" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

    </div>
  </div>
</section>