---
import { Picture } from 'astro:assets'
import hero from '../assets/menu/la-70-doble.jpg'
---
<section id="inicio" aria-labelledby="hero-title" class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:items-stretch lg:px-10">
  <div class="relative lg:order-2 lg:col-span-6 lg:py-10">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 600px, 100vw"
      alt="Hamburguesa doble con cheddar fundido sobre una tabla de pizarra"
      loading="eager"
      fetchpriority="high"
      class="h-52 w-full object-cover object-[50%_45%] sm:h-72 lg:h-full lg:min-h-[560px]"
    />
    <p class="absolute right-4 bottom-3 bg-carbon/85 px-2 py-1 text-[11px] tracking-wide text-papel uppercase lg:right-0 lg:bottom-13">
      La 70 Doble · $ 28.900
    </p>
  </div>

  <div class="px-4 pt-6 pb-10 sm:px-6 lg:order-1 lg:col-span-6 lg:flex lg:flex-col lg:justify-center lg:px-0 lg:py-16 lg:pr-12">
    <p class="text-xs tracking-[0.14em] text-ceniza uppercase">Hamburguesería al carbón · La 70, Laureles</p>
    <h1 id="hero-title" class="titular mt-3 text-[3.6rem] sm:text-7xl lg:text-[7rem]">
      Al carbón.<br />A tu casa en <span class="text-mostaza">40&nbsp;min.</span>
    </h1>
    <p class="mt-4 max-w-md text-[15px] leading-relaxed text-ceniza lg:mt-6 lg:text-base">
      Domicilios en Laureles, Estadio, Conquistadores, Belén y alrededores. Arma tu comanda y nos llega directo al WhatsApp.
    </p>
    <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6 lg:mt-10">
      <a href="#menu" class="titular flex h-14 items-center justify-center bg-mostaza px-8 whitespace-nowrap text-2xl tracking-[0.04em] text-carbon transition-transform hover:-translate-y-0.5 active:translate-y-0">
        Armar mi pedido
      </a>
      <a href="#domicilios" class="inline-flex min-h-11 items-center justify-center text-sm underline decoration-1 underline-offset-[6px] hover:decoration-2">
        Barrios y costo del domicilio
      </a>
    </div>
  </div>
</section>
