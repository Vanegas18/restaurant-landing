---
import { buildWhatsAppUrl, DEFAULT_MESSAGE } from '@/lib/whatsapp'
import WhatsAppIcon from '@/components/WhatsAppIcon.astro'

const waUrl = buildWhatsAppUrl(DEFAULT_MESSAGE)
---
<section id="inicio" class="relative overflow-hidden border-b border-border/60">

  <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-primary/20 blur-3xl"></div>

  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 md:py-20">

    <div class="flex flex-col items-start gap-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-3 py-1 text-xs font-medium text-muted-foreground">
        <span class="h-2 w-2 rounded-full bg-[#25D366]"></span>
        Abierto ahora · Entrega en ~30 min
      </span>

      <h1 class="text-balance text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
        Pide tu comida favorita en segundos
        <span class="text-primary">🍔</span>
      </h1>

      <p class="text-pretty text-lg leading-relaxed text-muted-foreground">
        Rápido, fácil y directo a tu WhatsApp. Sin apps, sin registros — solo
        elige lo que quieres y nosotros nos encargamos del resto.
      </p>

      <div class="flex w-full flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-md bg-[#25D366] px-6 text-base font-semibold text-black transition-colors hover:bg-[#1fbb57] sm:w-auto"
        >
          <WhatsAppIcon class="h-5 w-5" />
          Pedir por WhatsApp
        </a>
        <a
          href="#menu"
          class="inline-flex h-12 w-full items-center justify-center rounded-md border border-border bg-transparent px-6 text-base transition-colors hover:bg-secondary sm:w-auto"
        >
          Ver menú
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-2 text-sm text-muted-foreground">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 fill-primary text-primary" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="font-semibold text-foreground">4.9</span> (2,300+ reseñas)
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          Entrega rápida garantizada
        </span>
      </div>
    </div>

    <div class="relative">
      <div class="absolute inset-0 -z-10 translate-x-4 translate-y-4 rounded-3xl bg-primary/10"></div>
      <div class="overflow-hidden rounded-3xl border border-border">
        <img
          src="/hero-burger.png"
          alt="Hamburguesa doble con queso fundido"
          width="720"
          height="720"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="absolute -bottom-4 -left-4 flex items-center gap-3 rounded-2xl border border-border bg-card px-4 py-3 shadow-xl">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#25D366] text-black">
          <WhatsAppIcon class="h-5 w-5" />
        </span>
        <div class="leading-tight">
          <p class="text-sm font-semibold">Pide en 1 clic</p>
          <p class="text-xs text-muted-foreground">Directo a WhatsApp</p>
        </div>
      </div>
    </div>

  </div>
</section>