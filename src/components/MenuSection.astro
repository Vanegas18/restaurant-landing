---
import WhatsAppIcon from '@/components/WhatsAppIcon.astro'
import { buildWhatsAppUrl } from '@/lib/whatsapp'

type Product = {
  name: string
  description: string
  price: string
  image: string
  tag?: string
}

const products: Product[] = [
  {
    name: "Hamburguesa Clásica",
    description: "Carne 100% res, cheddar, lechuga, tomate y pan brioche.",
    price: "$22.000",
    image: "/menu-clasica.png",
    tag: "Más pedida",
  },
  {
    name: "Pizza Pepperoni",
    description: "Masa artesanal, queso mozzarella y pepperoni horneado.",
    price: "$35.000",
    image: "/menu-pizza.png",
  },
  {
    name: "Papas Crujientes",
    description: "Papas doradas con sal de mar y salsa de la casa.",
    price: "$5.500",
    image: "/menu-papas.png",
  },
  {
    name: "Pollo Crispy",
    description: "Tiras de pollo empanizado extra crujiente con dip.",
    price: "$11.000",
    image: "/menu-pollo.png",
  },
  {
    name: "Refresco Helado",
    description: "Bebida fría a elegir, servida con mucho hielo.",
    price: "$3.000",
    image: "/menu-bebida.png",
  },
  {
    name: "Combo Familiar",
    description: "Hamburguesa + papas + refresco. Ideal para compartir.",
    price: "$169.000",
    image: "/menu-combo.png",
    tag: "Ahorra 20%",
  },
]
---

<section id="menu" class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">

    <div class="mb-10 flex flex-col items-center gap-3 text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-primary">
        Nuestro menú
      </span>
      <h2 class="text-balance text-3xl font-black tracking-tight sm:text-4xl">
        Antojos que llegan a tu puerta
      </h2>
      <p class="max-w-xl text-pretty text-muted-foreground">
        Elige tu favorito y pídelo en segundos por WhatsApp. Preparado al
        momento con ingredientes frescos.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors hover:border-primary/50">
          <div class="relative aspect-4/3 overflow-hidden">
            <img
              src={p.image}
              alt={p.name}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            {p.tag && (
              <span class="absolute left-3 top-3 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">
                {p.tag}
              </span>
            )}
          </div>
          <div class="flex flex-1 flex-col gap-3 p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-lg font-bold leading-tight">{p.name}</h3>
              <span class="shrink-0 text-lg font-black text-primary">{p.price}</span>
            </div>
            <p class="flex-1 text-pretty text-sm leading-relaxed text-muted-foreground">
              {p.description}
            </p>
            <a
              href={buildWhatsAppUrl(`Hola, quiero pedir: ${p.name} (${p.price})`)}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#25D366] px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-[#1fbb57]"
            >
              <WhatsAppIcon class="h-4 w-4" />
              Pedir ahora
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>