---
const steps = [
  {
    step: "01",
    title: "Elige tu comida",
    description: "Explora el menú y decide qué se te antoja hoy.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-1.5-.75M3 13.125v3.375c0 .621.504 1.125 1.125 1.125h15.75c.621 0 1.125-.504 1.125-1.125v-3.375" />`,
  },
  {
    step: "02",
    title: "Escríbenos por WhatsApp",
    description: `Toca "Pedir ahora" y confirma tu orden en el chat.`,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />`,
  },
  {
    step: "03",
    title: "Recibe tu pedido",
    description: "Lo preparamos al momento y te lo llevamos calientito.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />`,
  },
]
---

<section id="como-funciona" class="border-b border-border/60 bg-card/40">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">

    <div class="mb-12 flex flex-col items-center gap-3 text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-accent">
        Así de fácil
      </span>
      <h2 class="text-balance text-3xl font-black tracking-tight sm:text-4xl">
        Ordena en 3 simples pasos
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <div class="relative flex flex-col items-start gap-4 rounded-2xl border border-border bg-card p-7">
          <span class="absolute right-5 top-4 text-5xl font-black text-border">
            {s.step}
          </span>
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/15 text-accent">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-6 w-6"
              set:html={s.icon}
            />
          </span>
          <h3 class="text-xl font-bold">{s.title}</h3>
          <p class="text-pretty text-sm leading-relaxed text-muted-foreground">
            {s.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>