---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Carbón — Hamburguesas al carbón a domicilio en Laureles, Medellín',
  description = 'Hamburguesas y perros al carbón con domicilio en Laureles, Estadio, Conquistadores y Belén. Arma tu comanda y pídela por WhatsApp.',
} = Astro.props
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b1a17" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#menu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-mostaza focus:p-3 focus:text-carbon">Saltar al menú</a>
    <slot />
  </body>
</html>
